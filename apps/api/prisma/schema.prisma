generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  NEW
  READY
  ASSIGNED
  PICKING
  REVIEW_REQUIRED
  COMPLETED
  CLOSED
  CANCELLED
}

enum PickType {
  PACKAGE
  PIECE
  REVIEW
}

enum ItemStatus {
  PENDING
  ASSIGNED
  ACTIVE
  PICKED
  NOT_FOUND
  SKIPPED
}

enum ProblemResolution {
  CONFIRMED
  RESOLVED
}

enum ShiftStatus {
  OFF_SHIFT
  AVAILABLE
  BUSY
}

enum EventType {
  SOURCE_UPDATED
  SOURCE_CANCELLED
  ORDER_ASSIGNED
  ORDER_STARTED
  ORDER_COMPLETED
  ITEM_ASSIGNED
  ITEM_REASSIGNED
  ITEM_ACTIVE
  ITEM_PICKED
  ITEM_NOT_FOUND
  ITEM_SKIPPED
  ITEM_UNDONE
  ITEM_REVIEWED
  PROBLEM_CONFIRMED
  PROBLEM_RETURNED
  ORDER_CLOSED
}

enum ImportStatus {
  SUCCESS
  DUPLICATE
  FAILED
}

enum EmailOrderStatus {
  RECEIVED
  IMPORTED
  DUPLICATE
  FAILED
}

model Order {
  id             String       @id @default(cuid())
  documentNumber String
  documentDate   DateTime     @db.Date
  warehouse      String
  sourceHash     String?      @unique
  sourceSystem   String?
  sourceId       String?
  sourceRevision String?
  sourceCustomer String?
  sourcePosted   Boolean      @default(true)
  status         OrderStatus  @default(NEW)
  startedAt      DateTime?
  completedAt    DateTime?
  closedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  items          OrderItem[]
  events         OrderEvent[]
  importAttempts ImportAttempt[]
  emailImports   EmailOrderImport[]

  @@unique([documentNumber, documentDate, warehouse])
  @@unique([sourceSystem, sourceId])
}

model EmailOrderImport {
  id             String           @id @default(cuid())
  sourceKey      String           @unique
  provider       String           @default("MANUAL")
  messageId      String
  sender         String
  subject        String
  receivedAt     DateTime
  attachmentId   String?
  attachmentName String
  attachmentHash String?
  status         EmailOrderStatus @default(RECEIVED)
  orderId        String?
  errorMessage   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  order          Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status, receivedAt])
  @@index([messageId])
  @@index([orderId])
}

model ImportAttempt {
  id             String       @id @default(cuid())
  filename       String
  sourceHash     String?
  status         ImportStatus
  orderId        String?
  documentNumber String?
  documentDate   DateTime?    @db.Date
  warehouse      String?
  itemCount      Int?
  warnings       Json?
  errorMessage   String?
  createdAt      DateTime     @default(now())
  order          Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([sourceHash])
  @@index([orderId])
}

model OrderItem {
  id              String     @id @default(cuid())
  orderId         String
  sourceLine       Int
  barcode          String?
  name             String
  groupKey         String
  packageQuantity  Decimal?   @db.Decimal(14, 3)
  pieceQuantity    Decimal?   @db.Decimal(14, 3)
  pickType         PickType
  pickQuantity     Decimal    @db.Decimal(14, 3)
  status           ItemStatus @default(PENDING)
  sortIndex        Int
  pickedAt         DateTime?
  problemResolution ProblemResolution?
  reviewComment    String?
  reviewedBy       String?
  reviewedAt       DateTime?
  assignedAt       DateTime?
  assignedWorkerId String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  order            Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  assignedWorker   Worker?    @relation(fields: [assignedWorkerId], references: [id], onDelete: SetNull)
  events           OrderEvent[]

  @@unique([orderId, sourceLine])
  @@index([orderId, sortIndex])
  @@index([orderId, groupKey])
  @@index([assignedWorkerId, status])
}

model Worker {
  id           String       @id @default(cuid())
  login        String       @unique
  passwordHash String
  name         String
  isActive     Boolean      @default(true)
  shiftStatus  ShiftStatus  @default(OFF_SHIFT)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  assignedItems OrderItem[]
  events       OrderEvent[]
  sessions     WorkerSession[]

  @@index([isActive, shiftStatus])
}

model WorkerSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  workerId   String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  worker     Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId, expiresAt])
  @@index([expiresAt])
}

model OrderEvent {
  id        String    @id @default(cuid())
  orderId   String
  itemId    String?
  workerId  String?
  type      EventType
  serverAt  DateTime  @default(now())
  deviceAt  DateTime?
  metadata  Json?
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item      OrderItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  worker    Worker?   @relation(fields: [workerId], references: [id], onDelete: SetNull)

  @@index([orderId, serverAt])
  @@index([itemId, serverAt])
  @@index([workerId, serverAt])
}
