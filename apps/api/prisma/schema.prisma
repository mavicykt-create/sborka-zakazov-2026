generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  NEW
  READY
  ASSIGNED
  PICKING
  REVIEW_REQUIRED
  COMPLETED
  CLOSED
}

enum PickType {
  PACKAGE
  PIECE
  REVIEW
}

enum ItemStatus {
  PENDING
  ASSIGNED
  ACTIVE
  PICKED
  NOT_FOUND
  SKIPPED
}

enum ShiftStatus {
  OFF_SHIFT
  AVAILABLE
  BUSY
}

enum EventType {
  ORDER_ASSIGNED
  ORDER_STARTED
  ORDER_COMPLETED
  ITEM_ASSIGNED
  ITEM_REASSIGNED
  ITEM_ACTIVE
  ITEM_PICKED
  ITEM_NOT_FOUND
  ITEM_SKIPPED
  ITEM_UNDONE
}

model Order {
  id             String       @id @default(cuid())
  documentNumber String
  documentDate   DateTime     @db.Date
  warehouse      String
  sourceHash     String?      @unique
  status         OrderStatus  @default(NEW)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  items          OrderItem[]
  events         OrderEvent[]

  @@unique([documentNumber, documentDate, warehouse])
}

model OrderItem {
  id              String     @id @default(cuid())
  orderId         String
  sourceLine       Int
  barcode          String?
  name             String
  groupKey         String
  packageQuantity  Decimal?   @db.Decimal(14, 3)
  pieceQuantity    Decimal?   @db.Decimal(14, 3)
  pickType         PickType
  pickQuantity     Decimal    @db.Decimal(14, 3)
  status           ItemStatus @default(PENDING)
  sortIndex        Int
  pickedAt         DateTime?
  assignedAt       DateTime?
  assignedWorkerId String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  order            Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  assignedWorker   Worker?    @relation(fields: [assignedWorkerId], references: [id], onDelete: SetNull)
  events           OrderEvent[]

  @@unique([orderId, sourceLine])
  @@index([orderId, sortIndex])
  @@index([orderId, groupKey])
  @@index([assignedWorkerId, status])
}

model Worker {
  id           String       @id @default(cuid())
  login        String       @unique
  passwordHash String
  name         String
  isActive     Boolean      @default(true)
  shiftStatus  ShiftStatus  @default(OFF_SHIFT)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  assignedItems OrderItem[]
  events       OrderEvent[]

  @@index([isActive, shiftStatus])
}

model OrderEvent {
  id        String    @id @default(cuid())
  orderId   String
  itemId    String?
  workerId  String?
  type      EventType
  serverAt  DateTime  @default(now())
  deviceAt  DateTime?
  metadata  Json?
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  item      OrderItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  worker    Worker?   @relation(fields: [workerId], references: [id], onDelete: SetNull)

  @@index([orderId, serverAt])
  @@index([itemId, serverAt])
  @@index([workerId, serverAt])
}
