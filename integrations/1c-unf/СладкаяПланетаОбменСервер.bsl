// Общий серверный модуль расширения 1С:УНФ.
// Сервер и путь фиксированы для действующего веб-сервиса; секрет хранится
// в отдельной константе расширения СладкаяПланетаКлючОбмена.

Процедура ПриЗаписиРасходнойНакладной(Источник, Отказ) Экспорт

	Попытка
		КлючОбмена = СокрЛП(Строка(Константы.СладкаяПланетаКлючОбмена.Получить()));
		Если ПустаяСтрока(КлючОбмена) Тогда
			ЗаписьЖурналаРегистрации(
				"СладкаяПланета.Обмен1С",
				УровеньЖурналаРегистрации.Ошибка,
				,
				Источник.Ссылка,
				"Не заполнен ключ обмена");
			Возврат;
		КонецЕсли;

		Данные = ДанныеРасходнойНакладной(Источник);
		ТелоЗапроса = СтрокаJSON(Данные);

		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
		Соединение = Новый HTTPСоединение(
			"sborka-zakaza-mavicykt.amvera.io",
			443,
			,
			,
			,
			30,
			ЗащищенноеСоединение);

		Запрос = Новый HTTPЗапрос("/api/integrations/1c/expense-invoices");
		Запрос.Заголовки.Вставить("Authorization", "Bearer " + КлючОбмена);
		Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Запрос.Заголовки.Вставить("Accept", "application/json");
		Запрос.УстановитьТелоИзСтроки(
			ТелоЗапроса,
			КодировкаТекста.UTF8,
			ИспользованиеByteOrderMark.НеИспользовать);

		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
			ВызватьИсключение СтрШаблон(
				"Веб-сервис вернул HTTP %1: %2",
				Ответ.КодСостояния,
				Лев(Ответ.ПолучитьТелоКакСтроку(), 1000));
		КонецЕсли;

		ЗаписьЖурналаРегистрации(
			"СладкаяПланета.Обмен1С",
			УровеньЖурналаРегистрации.Информация,
			,
			Источник.Ссылка,
			"Расходная накладная передана в веб-сервис");

	Исключение
		// Ошибка обмена не должна отменять запись хозяйственного документа.
		ЗаписьЖурналаРегистрации(
			"СладкаяПланета.Обмен1С",
			УровеньЖурналаРегистрации.Ошибка,
			,
			Источник.Ссылка,
			ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

Функция ДанныеРасходнойНакладной(ДокументОбъект)

	Данные = Новый Структура;
	Данные.Вставить("sourceId", Строка(ДокументОбъект.Ссылка.УникальныйИдентификатор()));
	Данные.Вставить("revision", ВерсияДокумента(ДокументОбъект));
	Данные.Вставить("posted", ДокументОбъект.Проведен);
	Данные.Вставить("documentNumber", СокрЛП(Строка(ДокументОбъект.Номер)));
	Данные.Вставить("documentDate", Формат(ДокументОбъект.Дата, "ДФ=yyyy-MM-dd"));
	Данные.Вставить("warehouse", ПредставлениеРеквизита(
		ДокументОбъект,
		МассивИмен("Склад", "СтруктурнаяЕдиница", "СкладОтправитель"),
		"Не определён"));
	Данные.Вставить("customer", ПредставлениеРеквизита(
		ДокументОбъект,
		МассивИмен("Контрагент", "Покупатель", "Заказчик"),
		""));
	Данные.Вставить("items", ТоварыДокумента(ДокументОбъект));

	Возврат Данные;

КонецФункции

Функция ТоварыДокумента(ДокументОбъект)

	Результат = Новый Массив;
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	МетаданныеТаблицы = Неопределено;
	ИмяТаблицы = "";

	Для Каждого ВозможноеИмя Из МассивИмен("Запасы", "Товары", "ТоварыУслуги") Цикл
		МетаданныеТаблицы = МетаданныеДокумента.ТабличныеЧасти.Найти(ВозможноеИмя);
		Если МетаданныеТаблицы <> Неопределено Тогда
			ИмяТаблицы = ВозможноеИмя;
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ПустаяСтрока(ИмяТаблицы) Тогда
		Возврат Результат;
	КонецЕсли;

	НомерСтроки = 0;
	Для Каждого СтрокаТоваров Из ДокументОбъект[ИмяТаблицы] Цикл
		Номенклатура = ЗначениеРеквизитаСтроки(
			СтрокаТоваров,
			МетаданныеТаблицы,
			МассивИмен("Номенклатура", "Товар"));
		Если Номенклатура = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Количество = ЗначениеРеквизитаСтроки(
			СтрокаТоваров,
			МетаданныеТаблицы,
			МассивИмен("Количество", "КоличествоЗапасов"));
		Если Количество = Неопределено Или Количество <= 0 Тогда
			Продолжить;
		КонецЕсли;

		НомерСтроки = НомерСтроки + 1;
		Единица = ЗначениеРеквизитаСтроки(
			СтрокаТоваров,
			МетаданныеТаблицы,
			МассивИмен("ЕдиницаИзмерения", "Единица", "ЕдиницаХранения"));

		Товар = Новый Структура;
		Товар.Вставить("lineNumber", НомерСтроки);
		Товар.Вставить("productId", УникальныйИдентификаторЗначения(Номенклатура));
		Товар.Вставить("sku", РеквизитСсылкиСтрокой(Номенклатура, МассивИмен("Артикул", "Код")));
		Товар.Вставить("name", СокрЛП(Строка(Номенклатура)));
		Товар.Вставить("quantity", Количество);
		Товар.Вставить("unit", СокрЛП(Строка(Единица)));
		Товар.Вставить("pickType", ТипОтбораПоЕдинице(Единица));
		Результат.Добавить(Товар);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ПредставлениеРеквизита(Объект, Имена, ЗначениеПоУмолчанию)

	МетаданныеОбъекта = Объект.Метаданные();
	Для Каждого Имя Из Имена Цикл
		Если МетаданныеОбъекта.Реквизиты.Найти(Имя) <> Неопределено Тогда
			Значение = Объект[Имя];
			Если ЗначениеЗаполнено(Значение) Тогда
				Возврат СокрЛП(Строка(Значение));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат ЗначениеПоУмолчанию;

КонецФункции

Функция ЗначениеРеквизитаСтроки(СтрокаТаблицы, МетаданныеТаблицы, Имена)

	Для Каждого Имя Из Имена Цикл
		Если МетаданныеТаблицы.Реквизиты.Найти(Имя) <> Неопределено Тогда
			Возврат СтрокаТаблицы[Имя];
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция УникальныйИдентификаторЗначения(Значение)

	Попытка
		Возврат Строка(Значение.УникальныйИдентификатор());
	Исключение
		Возврат "";
	КонецПопытки;

КонецФункции

Функция РеквизитСсылкиСтрокой(Ссылка, Имена)

	Попытка
		МетаданныеСсылки = Ссылка.Метаданные();
		Для Каждого Имя Из Имена Цикл
			Если Имя = "Код" Или МетаданныеСсылки.Реквизиты.Найти(Имя) <> Неопределено Тогда
				Значение = Ссылка[Имя];
				Если ЗначениеЗаполнено(Значение) Тогда
					Возврат СокрЛП(Строка(Значение));
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;
	Возврат "";

КонецФункции

Функция ТипОтбораПоЕдинице(Единица)

	Представление = НРег(СокрЛП(Строка(Единица)));
	Если СтрНайти(Представление, "упак") > 0
		Или СтрНайти(Представление, "короб") > 0
		Или СтрНайти(Представление, "ящ") > 0
		Или СтрНайти(Представление, "блок") > 0 Тогда
		Возврат "PACKAGE";
	КонецЕсли;
	Возврат "PIECE";

КонецФункции

Функция ВерсияДокумента(ДокументОбъект)

	Попытка
		Возврат Строка(ДокументОбъект.ВерсияДанных);
	Исключение
		Возврат Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-ddTHH:mm:ss");
	КонецПопытки;

КонецФункции

Функция СтрокаJSON(Данные)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();

КонецФункции

Функция МассивИмен(Значение1, Значение2 = Неопределено, Значение3 = Неопределено)

	Результат = Новый Массив;
	Результат.Добавить(Значение1);
	Если Значение2 <> Неопределено Тогда
		Результат.Добавить(Значение2);
	КонецЕсли;
	Если Значение3 <> Неопределено Тогда
		Результат.Добавить(Значение3);
	КонецЕсли;
	Возврат Результат;

КонецФункции
